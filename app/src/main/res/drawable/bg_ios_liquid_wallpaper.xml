<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="1080dp"
    android:height="2400dp"
    android:viewportWidth="1080"
    android:viewportHeight="2400">

    <!-- Base Midnight Obsidian Surface -->
    <path
        android:pathData="M0,0 L1080,0 L1080,2400 L0,2400 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="1080"
                android:endY="2400"
                android:startColor="#0A0E1A"
                android:centerColor="#070B14"
                android:endColor="#050810" />
        </aapt:attr>
    </path>

    <!-- Top Radiant Nebula (Cyan / Sapphire Glow) -->
    <path
        android:pathData="M-100,-100 Q400,200 900,-80 Q1200,600 600,850 Q100,1000 -150,500 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="400"
                android:centerY="250"
                android:gradientRadius="750"
                android:startColor="#4D06B6D4"
                android:centerColor="#261E3A8A"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <!-- Upper Right Electric Violet & Magenta Aurora Wave -->
    <path
        android:pathData="M300,-50 C700,100 1150,250 1150,800 C1150,1200 700,1050 450,850 C200,650 150,300 300,-50 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="850"
                android:centerY="500"
                android:gradientRadius="700"
                android:startColor="#597C3AED"
                android:centerColor="#266366F1"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <!-- Mid-screen Liquid Flow Curve (Oceanic Deep Teal & Azure) -->
    <path
        android:pathData="M-120,950 Q450,800 800,1250 Q1150,1700 650,1850 Q200,1950 -100,1550 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="350"
                android:centerY="1400"
                android:gradientRadius="800"
                android:startColor="#400284C7"
                android:centerColor="#1A0F766E"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <!-- Bottom Deep Purple & Rose Nebula Bloom -->
    <path
        android:pathData="M150,1650 Q850,1550 1180,1950 Q1150,2500 600,2450 Q-100,2500 50,1950 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="750"
                android:centerY="2100"
                android:gradientRadius="850"
                android:startColor="#4DF43F5E"
                android:centerColor="#264C1D95"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <!-- Ambient Floating Glass Light Rings (VisionOS Specular Refraction) -->
    <path
        android:strokeWidth="1.5"
        android:pathData="M250,350 A300,300 0 1,0 850,350 A300,300 0 1,0 250,350">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="250"
                android:startY="50"
                android:endX="850"
                android:endY="650"
                android:startColor="#3306B6D4"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <path
        android:strokeWidth="1.5"
        android:pathData="M-50,1300 A420,420 0 1,0 790,1300 A420,420 0 1,0 -50,1300">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="-50"
                android:startY="880"
                android:endX="790"
                android:endY="1720"
                android:startColor="#26818CF8"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>
</vector>
